                  <span class="schema-val ${r.c}">${r.v}</span>
                </div>
              `).join('')}
            </div>
          </div>
        `).join('')}
      </div>
    </div>
  `).join('');
}

function renderQuick(filter = 'all') {
  const list = document.getElementById('quickList');
  let filtered = quickData;
  if (filter !== 'all') filtered = quickData.filter(q => q.chapter === filter);
  list.innerHTML = filtered.map((q, i) => `
    <div class="quick-item" onclick="toggleQuick(this)">
      <div class="quick-num">${String(i+1).padStart(2,'0')}</div>
      <div class="quick-content">
        <div class="quick-q">${q.q}</div>
        <div class="quick-a">${q.a}</div>
      </div>
      <span class="quick-priority" style="background:rgba(52,152,219,0.15);color:var(--blue);border:1px solid rgba(52,152,219,0.3)">${q.chapter.toUpperCase()}</span>
    </div>
  `).join('');
}

// ===================== INTERACTIONS =====================
function flipCard(id) {
  const el = document.getElementById('fc_' + id);
  if (!el) return;
  el.classList.toggle('flipped');
}

function markCard(e, id, status) {
  e.stopPropagation();
  if (status === 'known') {
    knownCards[id] = true;
    delete unknownCards[id];
    showToast('✓ Als bekannt markiert');
  } else {
    unknownCards[id] = true;
    delete knownCards[id];
    showToast('↩ Zum Wiederholen vorgemerkt');
  }
  localStorage.setItem('knownCards', JSON.stringify(knownCards));
  localStorage.setItem('unknownCards', JSON.stringify(unknownCards));
  updateStats();
  const el = document.getElementById('fc_' + id);
  if (el) {
    el.classList.remove('flipped');
    el.style.opacity = '0.6';
    setTimeout(() => { if(el) el.style.opacity = '1'; }, 500);
  }
}

function toggleCase(id) {
  const ans = document.getElementById('cans_' + id);
  if (ans) ans.classList.toggle('visible');
}

function toggleQuick(el) {
  const ans = el.querySelector('.quick-a');
  if (ans) ans.classList.toggle('visible');
}

function switchTab(tab) {
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
  event.target.classList.add('active');
  document.getElementById('panel-' + tab).classList.add('active');
}

function filterCards(filter, btn) {
  document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  renderCards(filter);
}

function filterQuick(filter, btn) {
  document.querySelectorAll('#panel-quick .filter-btn').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  renderQuick(filter);
}

function showToast(msg) {
  const t = document.getElementById('toast');
  t.textContent = msg;
  t.classList.add('show');
  setTimeout(() => t.classList.remove('show'), 2000);
}

function updateStats() {
  const total = cardData.length;
  const known = Object.keys(knownCards).length;
  const mustCount = cardData.filter(c => c.priority === 'must').length;
  const pct = Math.round((known / total) * 100);

  document.getElementById('mustCount').textContent = mustCount;
  document.getElementById('knownCount').textContent = known;
  document.getElementById('totalCards').textContent = total;
  document.getElementById('pctKnown').textContent = pct + '%';
  document.getElementById('globalProgress').textContent = `${known} / ${total} Bekannt`;

  // Chapter progress
  const rbcTotal = cardData.filter(c => c.chapter === 'rbc').length;
  const wbcTotal = cardData.filter(c => c.chapter === 'wbc').length;
  const coagTotal = cardData.filter(c => c.chapter === 'coag').length;
  const rbcKnown = cardData.filter(c => c.chapter === 'rbc' && knownCards[c.id]).length;
  const wbcKnown = cardData.filter(c => c.chapter === 'wbc' && knownCards[c.id]).length;
  const coagKnown = cardData.filter(c => c.chapter === 'coag' && knownCards[c.id]).length;

  const p1 = Math.round((rbcKnown/rbcTotal)*100);
  const p2 = Math.round((wbcKnown/wbcTotal)*100);
  const p3 = Math.round((coagKnown/coagTotal)*100);

  ['1','2','3'].forEach((n, i) => {
    const p = [p1,p2,p3][i];
    document.getElementById('prog'+n).textContent = p + '%';
    document.getElementById('bar'+n).style.width = p + '%';
  });
}

// ===================== INIT =====================
renderCards();
renderCases();
renderSchemas();
renderQuick();
updateStats();
</script>

