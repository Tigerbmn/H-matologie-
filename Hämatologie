<!DOCTYPE html>

<html lang="de" dir="ltr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hämatologie — Facharztprüfung</title>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Syne:wght@400;700;800&family=IBM+Plex+Sans:wght@300;400;600&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #0a0c10;
  --surface: #111418;
  --surface2: #181c22;
  --border: #22272f;
  --accent: #e8352a;
  --accent2: #f5a623;
  --accent3: #2ecc71;
  --accent4: #3498db;
  --text: #e8eaed;
  --text2: #8a9ab0;
  --text3: #4a5568;
  --red: #e8352a;
  --orange: #f5a623;
  --green: #2ecc71;
  --blue: #3498db;
  --purple: #9b59b6;
  --card-h: 420px;
}

- { margin: 0; padding: 0; box-sizing: border-box; }

body {
background: var(–bg);
color: var(–text);
font-family: ‘IBM Plex Sans’, sans-serif;
min-height: 100vh;
overflow-x: hidden;
}

/* HEADER */
.header {
background: var(–surface);
border-bottom: 1px solid var(–border);
padding: 0 20px;
display: flex;
align-items: center;
justify-content: space-between;
height: 56px;
position: sticky;
top: 0;
z-index: 100;
}

.logo {
font-family: ‘Syne’, sans-serif;
font-weight: 800;
font-size: 16px;
letter-spacing: -0.5px;
display: flex;
align-items: center;
gap: 8px;
}

.logo-badge {
background: var(–accent);
color: white;
font-size: 10px;
padding: 2px 6px;
border-radius: 3px;
font-weight: 700;
letter-spacing: 1px;
}

.header-meta {
font-family: ‘JetBrains Mono’, monospace;
font-size: 11px;
color: var(–text2);
display: flex;
gap: 16px;
align-items: center;
}

.progress-pill {
background: var(–surface2);
border: 1px solid var(–border);
padding: 4px 10px;
border-radius: 20px;
font-size: 11px;
color: var(–accent3);
}

/* TABS */
.tabs {
display: flex;
background: var(–surface);
border-bottom: 1px solid var(–border);
padding: 0 20px;
gap: 0;
overflow-x: auto;
}

.tab {
padding: 12px 16px;
font-size: 12px;
font-family: ‘JetBrains Mono’, monospace;
color: var(–text3);
cursor: pointer;
border-bottom: 2px solid transparent;
white-space: nowrap;
transition: all 0.2s;
letter-spacing: 0.5px;
}

.tab:hover { color: var(–text2); }
.tab.active { color: var(–accent); border-bottom-color: var(–accent); }

/* MAIN LAYOUT */
.main {
max-width: 1100px;
margin: 0 auto;
padding: 24px 20px;
}

/* SECTION HEADER */
.section-header {
display: flex;
align-items: center;
justify-content: space-between;
margin-bottom: 20px;
}

.section-title {
font-family: ‘Syne’, sans-serif;
font-weight: 700;
font-size: 22px;
display: flex;
align-items: center;
gap: 10px;
}

.section-count {
font-family: ‘JetBrains Mono’, monospace;
font-size: 11px;
color: var(–text3);
background: var(–surface2);
padding: 3px 8px;
border-radius: 4px;
}

/* PRIORITY LEGEND */
.legend {
display: flex;
gap: 12px;
flex-wrap: wrap;
margin-bottom: 20px;
}

.legend-item {
display: flex;
align-items: center;
gap: 6px;
font-size: 11px;
color: var(–text2);
font-family: ‘JetBrains Mono’, monospace;
}

.dot {
width: 8px; height: 8px;
border-radius: 50%;
}

/* CARDS GRID */
.cards-grid {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
gap: 16px;
}

/* FLASHCARD */
.flashcard {
background: var(–surface);
border: 1px solid var(–border);
border-radius: 10px;
overflow: hidden;
cursor: pointer;
transition: all 0.25s;
position: relative;
}

.flashcard:hover {
border-color: var(–text3);
transform: translateY(-2px);
box-shadow: 0 8px 24px rgba(0,0,0,0.4);
}

.flashcard.flipped .card-front { display: none; }
.flashcard:not(.flipped) .card-back { display: none; }

.card-priority-bar {
height: 3px;
width: 100%;
}

.priority-must { background: var(–red); }
.priority-high { background: var(–orange); }
.priority-medium { background: var(–blue); }
.priority-low { background: var(–text3); }

.card-header {
padding: 14px 16px 10px;
display: flex;
align-items: flex-start;
justify-content: space-between;
gap: 8px;
}

.card-topic {
font-family: ‘JetBrains Mono’, monospace;
font-size: 10px;
color: var(–text3);
letter-spacing: 1px;
text-transform: uppercase;
}

.card-badges {
display: flex;
gap: 4px;
flex-wrap: wrap;
justify-content: flex-end;
}

.badge {
font-size: 9px;
padding: 2px 6px;
border-radius: 3px;
font-family: ‘JetBrains Mono’, monospace;
font-weight: 700;
letter-spacing: 0.5px;
white-space: nowrap;
}

.badge-exam { background: rgba(232,53,42,0.15); color: var(–red); border: 1px solid rgba(232,53,42,0.3); }
.badge-clinical { background: rgba(245,166,35,0.15); color: var(–orange); border: 1px solid rgba(245,166,35,0.3); }
.badge-formula { background: rgba(52,152,219,0.15); color: var(–blue); border: 1px solid rgba(52,152,219,0.3); }
.badge-merke { background: rgba(46,204,113,0.15); color: var(–green); border: 1px solid rgba(46,204,113,0.3); }

.card-question {
padding: 6px 16px 16px;
font-size: 14px;
font-weight: 600;
line-height: 1.5;
color: var(–text);
}

.card-flip-hint {
padding: 8px 16px;
font-size: 10px;
color: var(–text3);
font-family: ‘JetBrains Mono’, monospace;
border-top: 1px solid var(–border);
display: flex;
align-items: center;
gap: 6px;
}

/* CARD BACK */
.card-back {
background: var(–surface2);
}

.card-answer {
padding: 14px 16px;
font-size: 13px;
line-height: 1.7;
color: var(–text);
}

.answer-key {
font-weight: 600;
color: var(–accent3);
display: block;
margin-bottom: 8px;
font-size: 13px;
}

.answer-list {
list-style: none;
margin-top: 8px;
}

.answer-list li {
padding: 4px 0;
padding-left: 12px;
position: relative;
font-size: 12px;
color: var(–text2);
line-height: 1.5;
}

.answer-list li::before {
content: ‘→’;
position: absolute;
left: 0;
color: var(–text3);
}

.merke-box {
background: rgba(46,204,113,0.08);
border: 1px solid rgba(46,204,113,0.2);
border-radius: 6px;
padding: 8px 12px;
margin-top: 10px;
font-size: 12px;
color: var(–green);
font-family: ‘JetBrains Mono’, monospace;
}

.cave-box {
background: rgba(232,53,42,0.08);
border: 1px solid rgba(232,53,42,0.2);
border-radius: 6px;
padding: 8px 12px;
margin-top: 8px;
font-size: 12px;
color: var(–red);
}

.card-actions {
padding: 10px 16px;
border-top: 1px solid var(–border);
display: flex;
gap: 8px;
}

.action-btn {
flex: 1;
padding: 7px 0;
border: 1px solid var(–border);
background: var(–surface);
color: var(–text2);
border-radius: 6px;
font-size: 11px;
cursor: pointer;
font-family: ‘JetBrains Mono’, monospace;
transition: all 0.2s;
text-align: center;
}

.action-btn:hover { background: var(–surface2); color: var(–text); }
.action-btn.known { border-color: var(–green); color: var(–green); }
.action-btn.unknown { border-color: var(–red); color: var(–red); }

/* CLINICAL CASE CARD */
.case-card {
background: var(–surface);
border: 1px solid var(–border);
border-left: 3px solid var(–orange);
border-radius: 10px;
overflow: hidden;
cursor: pointer;
transition: all 0.25s;
grid-column: span 2;
}

@media (max-width: 700px) {
.case-card { grid-column: span 1; }
}

.case-card:hover {
border-color: var(–orange);
box-shadow: 0 8px 24px rgba(0,0,0,0.4);
}

.case-header {
padding: 14px 16px;
background: rgba(245,166,35,0.05);
border-bottom: 1px solid var(–border);
display: flex;
justify-content: space-between;
align-items: center;
}

.case-label {
font-family: ‘JetBrains Mono’, monospace;
font-size: 10px;
color: var(–orange);
letter-spacing: 1px;
font-weight: 700;
}

.case-body {
padding: 14px 16px;
}

.patient-line {
font-size: 13px;
color: var(–text2);
margin-bottom: 10px;
line-height: 1.5;
}

.lab-grid {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
gap: 6px;
margin: 10px 0;
}

.lab-item {
background: var(–surface2);
border: 1px solid var(–border);
border-radius: 6px;
padding: 6px 10px;
font-family: ‘JetBrains Mono’, monospace;
font-size: 11px;
}

.lab-name { color: var(–text3); font-size: 10px; }
.lab-value { color: var(–text); margin-top: 2px; }
.lab-value.abnormal { color: var(–red); }
.lab-value.normal { color: var(–green); }

.case-question {
font-size: 14px;
font-weight: 600;
color: var(–text);
margin-top: 12px;
padding-top: 12px;
border-top: 1px solid var(–border);
}

.case-answer {
display: none;
margin-top: 12px;
padding-top: 12px;
border-top: 1px solid var(–border);
}

.case-answer.visible { display: block; }

.diagnosis-box {
background: rgba(46,204,113,0.08);
border: 1px solid rgba(46,204,113,0.2);
border-radius: 8px;
padding: 12px 14px;
margin-bottom: 10px;
}

.diagnosis-label {
font-family: ‘JetBrains Mono’, monospace;
font-size: 10px;
color: var(–green);
letter-spacing: 1px;
margin-bottom: 4px;
}

.diagnosis-text {
font-size: 14px;
font-weight: 600;
color: var(–text);
}

.reasoning {
font-size: 12px;
color: var(–text2);
line-height: 1.6;
}

/* PROGRESS BAR */
.topic-progress {
background: var(–surface);
border: 1px solid var(–border);
border-radius: 10px;
padding: 16px 20px;
margin-bottom: 20px;
}

.topic-progress-title {
font-family: ‘Syne’, sans-serif;
font-size: 14px;
font-weight: 700;
margin-bottom: 12px;
color: var(–text2);
}

.progress-items {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
gap: 8px;
}

.progress-item {
display: flex;
flex-direction: column;
gap: 4px;
}

.progress-item-label {
display: flex;
justify-content: space-between;
font-size: 11px;
color: var(–text3);
font-family: ‘JetBrains Mono’, monospace;
}

.progress-bar-bg {
height: 4px;
background: var(–surface2);
border-radius: 2px;
overflow: hidden;
}

.progress-bar-fill {
height: 100%;
border-radius: 2px;
transition: width 0.5s ease;
}

/* FILTER BAR */
.filter-bar {
display: flex;
gap: 8px;
margin-bottom: 16px;
flex-wrap: wrap;
}

.filter-btn {
padding: 6px 12px;
border: 1px solid var(–border);
background: transparent;
color: var(–text3);
border-radius: 6px;
font-size: 11px;
cursor: pointer;
font-family: ‘JetBrains Mono’, monospace;
transition: all 0.2s;
}

.filter-btn:hover { color: var(–text2); border-color: var(–text3); }
.filter-btn.active { background: var(–accent); color: white; border-color: var(–accent); }

/* PANEL */
.panel { display: none; }
.panel.active { display: block; }

/* QUICK REVIEW */
.quick-list {
display: flex;
flex-direction: column;
gap: 8px;
}

.quick-item {
background: var(–surface);
border: 1px solid var(–border);
border-radius: 8px;
padding: 12px 16px;
display: flex;
align-items: flex-start;
gap: 12px;
cursor: pointer;
transition: all 0.2s;
}

.quick-item:hover {
border-color: var(–text3);
background: var(–surface2);
}

.quick-num {
font-family: ‘JetBrains Mono’, monospace;
font-size: 11px;
color: var(–text3);
min-width: 30px;
padding-top: 2px;
}

.quick-content {
flex: 1;
}

.quick-q {
font-size: 13px;
color: var(–text);
margin-bottom: 4px;
line-height: 1.4;
}

.quick-a {
font-size: 12px;
color: var(–text3);
display: none;
margin-top: 8px;
padding-top: 8px;
border-top: 1px solid var(–border);
line-height: 1.6;
}

.quick-a.visible {
display: block;
color: var(–accent3);
}

.quick-priority {
font-family: ‘JetBrains Mono’, monospace;
font-size: 9px;
padding: 2px 6px;
border-radius: 3px;
white-space: nowrap;
align-self: flex-start;
}

/* SCHEMA BOXES */
.schema-section {
margin-bottom: 28px;
}

.schema-title {
font-family: ‘Syne’, sans-serif;
font-size: 16px;
font-weight: 700;
margin-bottom: 12px;
padding-bottom: 8px;
border-bottom: 1px solid var(–border);
color: var(–text);
}

.schema-grid {
display: grid;
grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
gap: 10px;
}

.schema-box {
background: var(–surface);
border: 1px solid var(–border);
border-radius: 8px;
padding: 14px;
}

.schema-box-title {
font-family: ‘JetBrains Mono’, monospace;
font-size: 11px;
font-weight: 700;
letter-spacing: 0.5px;
margin-bottom: 8px;
}

.schema-rows {
display: flex;
flex-direction: column;
gap: 4px;
}

.schema-row {
display: flex;
justify-content: space-between;
font-size: 11px;
padding: 4px 0;
border-bottom: 1px solid var(–border);
}

.schema-row:last-child { border-bottom: none; }

.schema-key { color: var(–text2); }
.schema-val { color: var(–text); font-family: ‘JetBrains Mono’, monospace; text-align: right; }
.schema-val.red { color: var(–red); }
.schema-val.green { color: var(–green); }
.schema-val.orange { color: var(–orange); }

/* TOAST */
.toast {
position: fixed;
bottom: 20px;
right: 20px;
background: var(–surface);
border: 1px solid var(–border);
border-radius: 8px;
padding: 10px 16px;
font-size: 12px;
font-family: ‘JetBrains Mono’, monospace;
color: var(–text);
opacity: 0;
transform: translateY(10px);
transition: all 0.3s;
z-index: 1000;
}

.toast.show { opacity: 1; transform: translateY(0); }

/* SCROLLBAR */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: var(–bg); }
::-webkit-scrollbar-thumb { background: var(–surface2); border-radius: 3px; }

/* Responsive */
@media (max-width: 600px) {
.cards-grid { grid-template-columns: 1fr; }
.schema-grid { grid-template-columns: 1fr; }
}

.empty-state {
text-align: center;
padding: 60px 20px;
color: var(–text3);
font-family: ‘JetBrains Mono’, monospace;
font-size: 13px;
}

.stats-row {
display: grid;
grid-template-columns: repeat(4, 1fr);
gap: 12px;
margin-bottom: 24px;
}

.stat-box {
background: var(–surface);
border: 1px solid var(–border);
border-radius: 10px;
padding: 16px;
text-align: center;
}

.stat-num {
font-family: ‘Syne’, sans-serif;
font-size: 28px;
font-weight: 800;
line-height: 1;
margin-bottom: 4px;
}

.stat-label {
font-family: ‘JetBrains Mono’, monospace;
font-size: 10px;
color: var(–text3);
letter-spacing: 1px;
}

@media (max-width: 600px) {
.stats-row { grid-template-columns: repeat(2, 1fr); }
}
</style>

</head>
