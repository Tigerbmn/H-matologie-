function renderCards(filter = 'all') {
  const grid = document.getElementById('cardsGrid');
  let filtered = cardData;
  if (filter === 'must') filtered = cardData.filter(c => c.priority === 'must');
  else if (filter === 'high') filtered = cardData.filter(c => c.priority === 'high');
  else if (filter === 'medium') filtered = cardData.filter(c => c.priority === 'medium');
  else if (filter === 'rbc') filtered = cardData.filter(c => c.chapter === 'rbc');
  else if (filter === 'wbc') filtered = cardData.filter(c => c.chapter === 'wbc');
  else if (filter === 'coag') filtered = cardData.filter(c => c.chapter === 'coag');
  else if (filter === 'unknown') filtered = cardData.filter(c => unknownCards[c.id]);

  document.getElementById('cardCount').textContent = `${filtered.length} Karten`;

  grid.innerHTML = filtered.map(card => `
    <div class="flashcard" id="fc_${card.id}" onclick="flipCard('${card.id}')">
      <div class="card-priority-bar priority-${card.priority}"></div>
      <div class="card-front">
        <div class="card-header">
          <div class="card-topic">${card.topic}</div>
          <div class="card-badges">
            ${card.badges.map(b => `<span class="badge badge-${b}">${b.toUpperCase()}</span>`).join('')}
          </div>
        </div>
        <div class="card-question">${card.question}</div>
        <div class="card-flip-hint">↩ Tippen für Antwort</div>
      </div>
      <div class="card-back">
        <div class="card-header">
          <div class="card-topic">${card.topic}</div>
          <div class="card-badges">
            <span class="badge badge-exam">ANTWORT</span>
          </div>
        </div>
        <div class="card-answer">
          <span class="answer-key">▶ ${card.answer}</span>
          ${card.keyPoints ? `<ul class="answer-list">${card.keyPoints.map(p => `<li>${p}</li>`).join('')}</ul>` : ''}
          ${card.merke ? `<div class="merke-box">📌 MERKE: ${card.merke}</div>` : ''}
          ${card.cave ? `<div class="cave-box">⚠️ CAVE: ${card.cave}</div>` : ''}
