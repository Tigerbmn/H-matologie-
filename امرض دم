            <div style={{background:'#111418',border:'1px solid #1e2530',borderRadius:10,padding:14}}>
              <div style={{fontWeight:700,fontSize:13,marginBottom:12}}>⚡ Top 10 Prüfungsklassiker</div>
              {['Eisenmangel-Stadien: Speichereisen → Erythropoese → Anämie','Mentzer-Index: MCV/Ery · <13 Thalassämie · >13 Eisenmangel','TTP-Trias: Thrombopenie+Hämolyse+ZNS → Plasmapherese SOFORT!','PNH: Hämolyse+Thrombopenie+Thrombophilie → FACS (CD55/CD59)','CLL: Kernschatten + Lymphozytose → Binet → keine Heilung','CML: BCR-ABL → TKI (Imatinib) · chronisch→Akzeleration→Blastenkrise','Myelom: CRAB-Kriterien · M-Gradient · Hyperkalzämie','HIT II: nach 5–20 Tagen · Thrombosen · KEIN Heparin mehr!','ITP: <30k → Kortikosteroide first → dann Splenektomie','Hämophilie: Quick NORMAL · PTT↑ · kein Quick-Ausschluss!'].map((t,i)=>(
                <div key={i} style={{display:'flex',gap:10,padding:'7px 10px',background:'#181c22',borderRadius:6,borderLeft:'3px solid #e8352a',marginBottom:5}}>
                  <span style={{fontFamily:'monospace',fontSize:10,color:'#e8352a',minWidth:18}}>{String(i+1).padStart(2,'0')}</span>
                  <span style={{fontSize:12,lineHeight:1.5}}>{t}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        {/* FLASHCARDS */}
        {tab==='fc' && (
          <div>
            <div style={{display:'flex',gap:6,marginBottom:12,flexWrap:'wrap'}}>
              {[['all','Alle'],['must','🔴MUST'],['high','🟠HIGH'],['rbc','Rote BZ'],['wbc','Weiße BZ'],['coag','Gerinnung'],['unk','❌Nochmal']].map(([f,l])=>(
                <button key={f} onClick={()=>setFil(f)} style={{padding:'5px 10px',border:`1px solid ${fil===f?'#e8352a':'#1e2530'}`,background:fil===f?'#e8352a':'transparent',color:fil===f?'#fff':'#4a5568',borderRadius:6,fontSize:11,cursor:'pointer',fontFamily:'monospace'}}>{l}</button>
              ))}
            </div>
            <div style={{display:'grid',gridTemplateColumns:'repeat(auto-fill,minmax(290px,1fr))',gap:10}}>
              {cards.map(card=>(
                <div key={card.id} onClick={()=>doFlip(card.id)}
                  style={{background:'#111418',border:'1px solid #1e2530',borderRadius:10,overflow:'hidden',cursor:'pointer'}}>
                  <div style={{height:3,background:PC[card.priority]||'#4a5568'}}></div>
                  {!flip[card.id] ? (
                    <>
                      <div style={{padding:'11px 13px 7px',display:'flex',justifyContent:'space-between',alignItems:'flex-start'}}>
                        <span style={{fontFamily:'monospace',fontSize:10,color:'#4a5568',letterSpacing:1}}>{card.topic}</span>
                        <span style={{fontSize:9,padding:'2px 5px',borderRadius:3,background:'rgba(232,53,42,0.15)',color:'#e8352a',border:'1px solid rgba(232,53,42,0.3)',fontFamily:'monospace',fontWeight:700}}>{card.priority.toUpperCase()}</span>
                      </div>
                      <div style={{padding:'3px 13px 13px',fontSize:13,fontWeight:600,lineHeight:1.5}}>{card.question}</div>
                      <div style={{padding:'7px 13px',fontSize:10,color:'#4a5568',fontFamily:'monospace',borderTop:'1px solid #1e2530'}}>↩ Tippen für Antwort</div>
                    </>
                  ) : (
                    <div style={{background:'#181c22'}}>
                      <div style={{padding:'11px 13px 7px'}}>
                        <span style={{fontFamily:'monospace',fontSize:10,color:'#4a5568',letterSpacing:1}}>{card.topic} — ANTWORT</span>
                      </div>
                      <div style={{padding:'3px 13px 13px'}}>
                        <div style={{fontWeight:600,color:'#2ecc71',marginBottom:8,fontSize:13}}>▶ {card.answer}</div>
                        {card.points&&<ul style={{listStyle:'none',margin:0,padding:0}}>
                          {card.points.map((p,i)=><li key={i} style={{padding:'3px 0 3px 14px',position:'relative',fontSize:12,color:'#8a9ab0',lineHeight:1.5}}>→ {p}</li>)}
                        </ul>}
                        {card.merke&&<div style={{background:'rgba(46,204,113,0.08)',border:'1px solid rgba(46,204,113,0.2)',borderRadius:6,padding:'7px 10px',marginTop:8,fontSize:12,color:'#2ecc71',fontFamily:'monospace'}}>📌 {card.merke}</div>}
                      </div>
                      <div style={{padding:'7px 13px',borderTop:'1px solid #1e2530',display:'flex',gap:7}}>
                        <button onClick={e=>doMark(e,card.id,'k')} style={{flex:1,padding:'6px 0',border:'1px solid #2ecc71',background:'transparent',color:'#2ecc71',borderRadius:6,fontSize:11,cursor:'pointer',fontFamily:'monospace'}}>✓ Bekannt</button>
                        <button onClick={e=>doMark(e,card.id,'u')} style={{flex:1,padding:'6px 0',border:'1px solid #e8352a',background:'transparent',color:'#e8352a',borderRadius:6,fontSize:11,cursor:'pointer',fontFamily:'monospace'}}>✗ Nochmal</button>
                      </div>
                    </div>
                  )}
                </div>
              ))}
            </div>
          </div>
        )}

        {/* CASES */}
        {tab==='ca' && (
          <div>
            <div style={{fontWeight:700,fontSize:18,marginBottom:14}}>🩺 Klinische Fälle</div>
            {cases.map(c=>(
              <div key={c.id} onClick={()=>setOpenC(p=>({...p,[c.id]:!p[c.id]}))}
                style={{background:'#111418',border:'1px solid #1e2530',borderLeft:'3px solid #f5a623',borderRadius:10,overflow:'hidden',cursor:'pointer',marginBottom:10}}>
                <div style={{padding:'11px 13px',background:'rgba(245,166,35,0.05)',borderBottom:'1px solid #1e2530',display:'flex',justifyContent:'space-between',alignItems:'center'}}>
                  <span style={{fontFamily:'monospace',fontSize:10,color:'#f5a623',fontWeight:700,letterSpacing:1}}>KLINISCHER FALL</span>
                  <span style={{fontFamily:'monospace',fontSize:10,color:'#4a5568'}}>{openC[c.id]?'▲':'▼'}</span>
                </div>
                <div style={{padding:'11px 13px'}}>
                  <div style={{fontSize:13,color:'#8a9ab0',marginBottom:8,lineHeight:1.5}}>🧑‍⚕️ {c.patient}</div>
                  <div style={{display:'grid',gridTemplateColumns:'repeat(auto-fill,minmax(110px,1fr))',gap:5,margin:'8px 0'}}>
                    {c.labs.map(l=>(
                      <div key={l.n} style={{background:'#0a0c10',border:'1px solid #1e2530',borderRadius:6,padding:'5px 8px',fontFamily:'monospace',fontSize:11}}>
                        <div style={{color:'#4a5568',fontSize:10}}>{l.n}</div>
                        <div style={{color:l.a?'#e8352a':'#2ecc71',marginTop:2,fontWeight:600}}>{l.v}</div>
                      </div>
                    ))}
                  </div>
                  <div style={{fontSize:13,fontWeight:600,marginTop:10,paddingTop:10,borderTop:'1px solid #1e2530'}}>❓ {c.q}</div>
                  {openC[c.id]&&(
                    <>
                      <div style={{background:'rgba(46,204,113,0.08)',border:'1px solid rgba(46,204,113,0.2)',borderRadius:8,padding:'10px 12px',margin:'10px 0 6px'}}>
                        <div style={{fontFamily:'monospace',fontSize:10,color:'#2ecc71',marginBottom:4,letterSpacing:1}}>DIAGNOSE</div>
                        <div style={{fontSize:14,fontWeight:600}}>{c.dx}</div>
                      </div>
                      <div style={{fontSize:12,color:'#8a9ab0',lineHeight:1.7}}>{c.r}</div>
                    </>
                  )}
                </div>
              </div>
            ))}
          </div>
        )}

        {/* QUICK REVIEW */}
        {tab==='qr' && (
          <div>
            <div style={{display:'flex',gap:6,marginBottom:12,flexWrap:'wrap'}}>
              {[['all','Alle'],['rbc','Rote BZ'],['wbc','Weiße BZ'],['coag','Gerinnung']].map(([f,l])=>(
                <button key={f} onClick={()=>setQfil(f)} style={{padding:'5px 10px',border:`1px solid ${qfil===f?'#e8352a':'#1e2530'}`,background:qfil===f?'#e8352a':'transparent',color:qfil===f?'#fff':'#4a5568',borderRadius:6,fontSize:11,cursor:'pointer',fontFamily:'monospace'}}>{l}</button>
              ))}
            </div>
            {qs.map((q,i)=>(
              <div key={i} onClick={()=>setOpenQ(p=>({...p,[i]:!p[i]}))}
                style={{background:'#111418',border:'1px solid #1e2530',borderRadius:8,padding:'11px 13px',display:'flex',gap:10,cursor:'pointer',marginBottom:6}}>
                <div style={{fontFamily:'monospace',fontSize:11,color:'#4a5568',minWidth:22,paddingTop:2}}>{String(i+1).padStart(2,'0')}</div>
                <div style={{flex:1}}>
                  <div style={{fontSize:13,lineHeight:1.4}}>{q.q}</div>
                  {openQ[i]&&<div style={{fontSize:12,color:'#2ecc71',marginTop:8,paddingTop:8,borderTop:'1px solid #1e2530',lineHeight:1.6}}>{q.a}</div>}
                </div>
                <span style={{fontFamily:'monospace',fontSize:9,padding:'2px 5px',borderRadius:3,background:'rgba(52,152,219,0.15)',color:'#3498db',border:'1px solid rgba(52,152,219,0.3)',alignSelf:'flex-start',whiteSpace:'nowrap'}}>{q.c.toUpperCase()}</span>
              </div>
            ))}
          </div>
        )}

      </div>

      {toast&&<div style={{position:'fixed',bottom:18,right:18,background:'#111418',border:'1px solid #1e2530',borderRadius:8,padding:'8px 14px',fontSize:12,fontFamily:'monospace',zIndex:999}}>{toast}</div>}
    </div>
  );
}